<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>일반생물학Ⅰ 기말고사 메이트</title>
  
  <!-- React & Standalone Babel CDN -->
  <script src="https://unpkg.com/react@18/umd/react.production.min.js" crossorigin></script>
  <script src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js" crossorigin></script>
  <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>
  
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  
  <!-- KaTeX 수학/과학 수식 엔진 CDN -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.8/dist/katex.min.css">
  <script src="https://cdn.jsdelivr.net/npm/katex@0.16.8/dist/katex.min.js"></script>

  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Noto+Sans+KR:wght@300;400;500;700;900&display=swap');
    
    body {
      font-family: 'Inter', 'Noto Sans KR', sans-serif;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(8px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .animate-fadeIn {
      animation: fadeIn 0.35s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
    
    /* Scrollbar Styling */
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: #f1f5f9;
    }
    ::-webkit-scrollbar-thumb {
      background: #cbd5e1;
      border-radius: 4px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #94a3b8;
    }
  </style>
</head>
<body class="bg-slate-50 text-slate-800 antialiased leading-relaxed">
  <div id="root"></div>

  <script type="text/babel">
    const { useState, useEffect, useRef } = React;

    // --- 커스텀 고해상도 SVG 아이콘 모음 (의존성 제로화 및 로딩 속도 최적화) ---
    const IconLeaf = () => (
      <svg className="w-5 h-5 text-emerald-500" fill="none" stroke="currentColor" strokeWidth="2.5" viewBox="0 0 24 24">
        <path strokeLinecap="round" strokeLinejoin="round" d="M12 3v18M12 3c-4.97 0-9 4.03-9 9 0 2.12.74 4.07 1.97 5.61L12 12m0-9c4.97 0 9 4.03 9 9 0 2.12-.74 4.07-1.97 5.61L12 12m0 0l5.5 5.5" />
      </svg>
    );

    const IconActivity = () => (
      <svg className="w-5 h-5 text-rose-500" fill="none" stroke="currentColor" strokeWidth="2.5" viewBox="0 0 24 24">
        <path strokeLinecap="round" strokeLinejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z" />
      </svg>
    );

    const IconBookOpen = () => (
      <svg className="w-5 h-5 text-white" fill="none" stroke="currentColor" strokeWidth="2.5" viewBox="0 0 24 24">
        <path strokeLinecap="round" strokeLinejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
      </svg>
    );

    const IconRotateCcw = () => (
      <svg className="w-4 h-4" fill="none" stroke="currentColor" strokeWidth="2.5" viewBox="0 0 24 24">
        <path strokeLinecap="round" strokeLinejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182m0-4.991v4.99" />
      </svg>
    );

    const IconEye = () => (
      <svg className="w-4 h-4" fill="none" stroke="currentColor" strokeWidth="2.2" viewBox="0 0 24 24">
        <path strokeLinecap="round" strokeLinejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z" />
        <path strokeLinecap="round" strokeLinejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
      </svg>
    );

    const IconEyeOff = () => (
      <svg className="w-4 h-4" fill="none" stroke="currentColor" strokeWidth="2.2" viewBox="0 0 24 24">
        <path strokeLinecap="round" strokeLinejoin="round" d="M3.98 8.223A10.477 10.477 0 001.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.45 10.45 0 0112 4.5c4.756 0 8.773 3.162 10.065 7.498a10.523 10.523 0 01-4.293 5.774M6.228 6.228L3 3m3.228 3.228l3.65 3.65m7.894 7.894L21 21m-3.228-3.228l-3.65-3.65m0 0a3 3 0 10-4.243-4.243m4.242 4.242L9.88 9.88" />
      </svg>
    );

    const IconCheckCircle = () => (
      <svg className="w-4 h-4" fill="none" stroke="currentColor" strokeWidth="2" viewBox="0 0 24 24">
        <path strokeLinecap="round" strokeLinejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
    );

    const IconCompass = () => (
      <svg className="w-4 h-4" fill="none" stroke="currentColor" strokeWidth="2" viewBox="0 0 24 24">
        <path strokeLinecap="round" strokeLinejoin="round" d="M12 21a9.004 9.004 0 008.716-6.747M12 21a9.004 9.004 0 01-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9s2.015-9 4.5-9m0 0a9.003 9.003 0 018.716 2.253M12 3a9.003 9.003 0 00-8.716 2.253M12 12h.01" />
      </svg>
    );

    const IconAward = () => (
      <svg className="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" strokeWidth="2" viewBox="0 0 24 24">
        <path strokeLinecap="round" strokeLinejoin="round" d="M16.5 18.75h-9m9 0a3 3 0 013 3h-15a3 3 0 013-3m9 0v-3.375c0-.621-.504-1.125-1.125-1.125h-6.75a1.125 1.125 0 00-1.125 1.125v3.375m9 0h-9" />
      </svg>
    );

    const IconSliders = () => (
      <svg className="w-4 h-4" fill="none" stroke="currentColor" strokeWidth="2" viewBox="0 0 24 24">
        <path strokeLinecap="round" strokeLinejoin="round" d="M10.5 6h9.75M10.5 6a1.5 1.5 0 11-3 0m3 0a1.5 1.5 0 10-3 0M3.75 6H7.5m3 12h9.75m-9.75 0a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m-3.75 0H7.5m9-6h3.75" />
      </svg>
    );

    const IconClipboard = () => (
      <svg className="w-4 h-4" fill="none" stroke="currentColor" strokeWidth="2" viewBox="0 0 24 24">
        <path strokeLinecap="round" strokeLinejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01" />
      </svg>
    );

    const IconScience = () => (
      <svg className="w-5 h-5 text-indigo-500" fill="none" stroke="currentColor" strokeWidth="2.5" viewBox="0 0 24 24">
        <path strokeLinecap="round" strokeLinejoin="round" d="M9.75 9.75l4.5 4.5m0-4.5l-4.5 4.5M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
    );

    const IconZap = ({ className = "w-5 h-5 text-amber-500" }) => (
      <svg className={className} fill="none" stroke="currentColor" strokeWidth="2" viewBox="0 0 24 24">
        <path strokeLinecap="round" strokeLinejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z" />
      </svg>
    );

    const IconList = () => (
      <svg className="w-4 h-4 text-emerald-500" fill="none" stroke="currentColor" strokeWidth="2.5" viewBox="0 0 24 24">
        <path strokeLinecap="round" strokeLinejoin="round" d="M8.25 6.75h12M8.25 12h12m-12 5.25h12M3.75 6.75h.007v.008H3.75V6.75zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zM3.75 12h.007v.008H3.75V12zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm-3.75 5.25h.007v.008H3.75v-.008zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z" />
      </svg>
    );

    // --- 고정밀 실시간 수식 렌더러 Component ---
    const MathFormula = ({ math, block = false }) => {
      const elRef = useRef(null);
      useEffect(() => {
        if (window.katex && elRef.current) {
          try {
            window.katex.render(math, elRef.current, {
              throwOnError: false,
              displayMode: block,
            });
          } catch (e) {
            elRef.current.textContent = math;
          }
        } else if (elRef.current) {
          elRef.current.textContent = math;
        }
      }, [math, block]);

      return <span ref={elRef} className={`${block ? 'block my-3 text-center overflow-x-auto py-2 text-indigo-600 font-semibold text-[15px]' : 'inline-block px-1 text-indigo-600 font-semibold'}`} />;
    };

    // --- 메인 App 컴포넌트 ---
    function App() {
      const [showAll, setShowAll] = useState(false);
      const [userAnswers, setUserAnswers] = useState({});
      const [activeTab, setActiveTab] = useState('quiz_prep'); // 'quiz_prep' | 'exam_full' | 'lecture_notes' | 'chem_physics' | 'formulas_all'
      const [score, setScore] = useState(0);

      // 전체 빈칸의 개수 매핑 (총 150개 영역)
      const TOTAL_BLANKS = 150;

      const toggleBlank = (id) => {
        setUserAnswers(prev => ({
          ...prev,
          [id]: !prev[id]
        }));
      };

      const handleToggleAll = () => {
        const newState = !showAll;
        setShowAll(newState);
        const updated = {};
        for (let i = 1; i <= TOTAL_BLANKS; i++) {
          updated[`q${i}`] = newState;
        }
        setUserAnswers(updated);
      };

      useEffect(() => {
        const count = Object.keys(userAnswers).filter(key => userAnswers[key]).length;
        setScore(count);
      }, [userAnswers]);

      const handleReset = () => {
        setUserAnswers({});
        setShowAll(false);
        setScore(0);
      };

      // --- 실시간 수식 매칭형 빈칸 카드 컴포넌트 ---
      const Blank = ({ id, answer, hint, isMath = false }) => {
        const isRevealed = userAnswers[id] || showAll;
        return (
          <span
            onClick={() => toggleBlank(id)}
            title={hint ? `힌트: ${hint}` : '클릭해서 정답 보기'}
            className={`inline-flex items-center justify-center mx-1 px-3 py-0.5 rounded-md cursor-pointer transition-all duration-300 transform font-bold select-none border-b-2 ${
              isRevealed
                ? 'bg-emerald-50 text-emerald-950 border-emerald-400 scale-100 shadow-sm'
                : 'bg-indigo-100 text-indigo-100 hover:bg-indigo-200 border-indigo-300 animate-pulse min-w-[5.5rem]'
            }`}
          >
            {isRevealed ? (
              isMath ? <MathFormula math={answer} /> : answer
            ) : (
              '❔'
            )}
          </span>
        );
      };

      // --- 글자 하나하나씩 격막형 쪼개기용 컴포넌트 (쪽지시험 전용 포맷) ---
      const LetterBlank = ({ id, answerChar, hint }) => {
        const isRevealed = userAnswers[id] || showAll;
        return (
          <span
            onClick={() => toggleBlank(id)}
            title={hint || '클릭해서 정답 글자 확인'}
            className={`inline-flex items-center justify-center w-7 h-7 mx-0.5 rounded-md border text-center font-extrabold text-sm select-none cursor-pointer transition-all duration-300 transform ${
              isRevealed
                ? 'bg-amber-100 text-amber-950 border-amber-400 scale-105 shadow-inner'
                : 'bg-indigo-200 text-indigo-200 hover:bg-indigo-300 border-indigo-400 animate-pulse'
            }`}
          >
            {isRevealed ? answerChar : ''}
          </span>
        );
      };

      return (
        <div className="min-h-screen bg-slate-50 text-slate-800 flex flex-col animate-fadeIn">
          {/* Header */}
          <header className="bg-slate-900 text-white shadow-xl border-b border-emerald-500/30 sticky top-0 z-50">
            <div className="max-w-6xl mx-auto px-4 py-4 flex flex-col sm:flex-row justify-between items-center gap-4">
              <div className="flex items-center gap-3">
                <div className="p-2.5 bg-emerald-600 rounded-xl shadow-lg shadow-emerald-500/30">
                  <IconBookOpen />
                </div>
                <div>
                  <h1 className="text-xl font-black tracking-tight flex items-center gap-2">
                    일반생물학Ⅰ <span className="text-xs bg-emerald-500/50 text-emerald-200 px-2 py-0.5 rounded-full font-bold">기말고사 메이트</span>
                  </h1>
                  <p className="text-xs text-slate-400 font-medium">상명대학교 일반생물학1 (2분반) 모바일 반응형 완벽 암기장</p>
                </div>
              </div>

              <div className="flex items-center gap-3 flex-wrap">
                <div className="text-xs font-semibold px-3 py-1.5 bg-slate-800 border border-slate-700 rounded-lg flex items-center gap-2">
                  <IconAward />
                  <span>인출 성취율: <span className="text-emerald-400 font-bold">{score}</span> / {TOTAL_BLANKS}</span>
                </div>
                
                <button
                  onClick={handleToggleAll}
                  className="flex items-center gap-1.5 px-3 py-1.5 text-xs font-bold rounded-lg transition-all border border-slate-700 hover:border-indigo-400 bg-slate-800 hover:bg-slate-750 text-slate-200"
                >
                  {showAll ? <IconEyeOff /> : <IconEye />}
                  {showAll ? '전체 가리기' : '정답 모두 보기'}
                </button>

                <button
                  onClick={handleReset}
                  className="p-1.5 text-slate-400 hover:text-red-400 hover:bg-slate-800 rounded-lg transition-colors border border-transparent hover:border-slate-700"
                  title="초기화"
                >
                  <IconRotateCcw />
                </button>
              </div>
            </div>
          </header>

          {/* Hero Banner */}
          <section className="bg-gradient-to-r from-slate-900 via-emerald-950 to-slate-900 text-white py-8 px-4 border-b border-emerald-900">
            <div className="max-w-5xl mx-auto flex flex-col md:flex-row items-center justify-between gap-6">
              <div className="space-y-2 max-w-2xl">
                <div className="inline-flex items-center gap-1 bg-emerald-500/20 text-emerald-300 text-xs px-2.5 py-1 rounded-full border border-emerald-500/30 font-bold">
                  <IconLeaf />
                  <span>9주차 ~ 13주차 기말 전 범위 지엽 암기 노트 및 매커니즘 전체 수록</span>
                </div>
                <h2 className="text-2xl md:text-3xl font-extrabold tracking-tight">
                  기말고사 및 쪽지시험 완벽 정복 학습지
                </h2>
                <p className="text-slate-300 text-sm leading-relaxed">
                  중간고사 내용은 완전히 배제하고, 오직 <strong>기말 범위(9~13주차)</strong>의 디테일만을 완벽하게 채웠습니다. 메커니즘 도해 및 상세 개념집을 통과하여 완벽한 인출 암기를 이룩하세요.
                </p>
              </div>
            </div>
          </section>

          {/* Navigation tabs */}
          <div className="bg-white border-b border-slate-200 sticky top-[73px] sm:top-[77px] z-40 shadow-sm">
            <div className="max-w-5xl mx-auto px-4 flex gap-2 overflow-x-auto">
              <button
                onClick={() => setActiveTab('quiz_prep')}
                className={`py-4 px-3 sm:px-5 font-bold text-sm border-b-2 transition-all flex items-center gap-2 whitespace-nowrap ${
                  activeTab === 'quiz_prep'
                    ? 'border-emerald-600 text-emerald-600'
                    : 'border-transparent text-slate-500 hover:text-slate-800'
                }`}
              >
                <IconList />
                <span>주차별 쪽지시험 대비 (전체 5%)</span>
              </button>

              <button
                onClick={() => setActiveTab('exam_full')}
                className={`py-4 px-3 sm:px-5 font-bold text-sm border-b-2 transition-all flex items-center gap-2 whitespace-nowrap ${
                  activeTab === 'exam_full'
                    ? 'border-emerald-600 text-emerald-600'
                    : 'border-transparent text-slate-500 hover:text-slate-800'
                }`}
              >
                <IconCheckCircle />
                <span>기말대비 핵심 암기 30선</span>
              </button>
              
              <button
                onClick={() => setActiveTab('lecture_notes')}
                className={`py-4 px-3 sm:px-5 font-bold text-sm border-b-2 transition-all flex items-center gap-2 whitespace-nowrap ${
                  activeTab === 'lecture_notes'
                    ? 'border-emerald-600 text-emerald-600'
                    : 'border-transparent text-slate-500 hover:text-slate-800'
                }`}
              >
                <IconCompass />
                <span>주차별 매커니즘 도해 (전수 수록)</span>
              </button>

              <button
                onClick={() => setActiveTab('chem_physics')}
                className={`py-4 px-3 sm:px-5 font-bold text-sm border-b-2 transition-all flex items-center gap-2 whitespace-nowrap ${
                  activeTab === 'chem_physics'
                    ? 'border-emerald-600 text-emerald-600'
                    : 'border-transparent text-slate-500 hover:text-slate-800'
                }`}
              >
                <IconZap className="w-4 h-4 text-amber-500" />
                <span>생명공학기술 (Biotechnology) 존</span>
              </button>

              <button
                onClick={() => setActiveTab('formulas_all')}
                className={`py-4 px-3 sm:px-5 font-bold text-sm border-b-2 transition-all flex items-center gap-2 whitespace-nowrap ${
                  activeTab === 'formulas_all'
                    ? 'border-emerald-600 text-emerald-600'
                    : 'border-transparent text-slate-500 hover:text-slate-800'
                }`}
              >
                <IconClipboard />
                <span>기말대비 전체 핵심집 (초고밀도 지엽 수록)</span>
              </button>
            </div>
          </div>

          {/* Main Content Areas */}
          <main className="flex-1 max-w-5xl w-full mx-auto px-4 py-8">
            
            {/* Tab 0: 주차별 쪽지시험 대비 (기말 버전) */}
            {activeTab === 'quiz_prep' && (
              <div className="space-y-6 animate-fadeIn">
                <div className="pb-2 border-b border-slate-200 flex justify-between items-center">
                  <h3 className="text-lg font-black text-slate-900 flex items-center gap-2">
                    <span className="w-2.5 h-6 bg-emerald-600 rounded-sm"></span>
                    기말 범위 주차별 쪽지시험 완벽 정복 (각 주차별 2문항 엄선)
                  </h3>
                  <span className="text-xs bg-amber-50 text-amber-800 px-3 py-1 rounded-full font-bold border border-amber-200">글자 격자형 암기 포맷</span>
                </div>

                <div className="grid grid-cols-1 gap-6">
                  {/* 9주차 쪽지시험 */}
                  <div className="bg-white p-5 rounded-xl border border-slate-200 shadow-sm space-y-4">
                    <div className="flex items-center justify-between border-b pb-2">
                      <span className="font-extrabold text-sm text-emerald-600 flex items-center gap-1">
                        <IconLeaf /> [9주차] 식물의 생식과 구조 쪽지시험
                      </span>
                      <span className="text-xs text-slate-400">배점 5% 연계</span>
                    </div>
                    <div className="space-y-4 text-slate-700 text-[14px]">
                      <div className="p-3.5 bg-slate-50 rounded-lg space-y-2">
                        <p className="font-semibold text-slate-800">1. 나자식물은 수분 이후 피자식물과 다르게 단일수정을 진행하여 종자 성숙 시 영양 공급 조직으로 반수체 상태(n)의 이것을 사용한다.</p>
                        <div className="flex items-center gap-1.5 flex-wrap">
                          <span className="text-slate-500 font-medium">정답: </span>
                          <LetterBlank id="q101" answerChar="자" />
                          <LetterBlank id="q102" answerChar="성" />
                          <LetterBlank id="q103" answerChar="배" />
                          <LetterBlank id="q104" answerChar="우" />
                          <LetterBlank id="q105" answerChar="자" />
                          <LetterBlank id="q106" answerChar="체" />
                        </div>
